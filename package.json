{
  "name": "notevault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:all": "concurrently -n convex,next -c cyan,magenta \"npx convex dev\" \"next dev --turbopack\"",
    "build": "next build --webpack",
    "build:vercel": "convex deploy --cmd 'npm run build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test --project=chromium",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:e2e:storybook": "playwright test --project=storybook",
    "playwright:install": "playwright install chromium",
    "deploy:convex": "convex deploy",
    "postinstall": "mkdir -p public/embedpdf && cp node_modules/@embedpdf/pdfium/dist/pdfium.wasm public/embedpdf/pdfium.wasm",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@casl/react": "^7.0.1",
    "@clerk/nextjs": "^7.5.20",
    "@clerk/themes": "^2.4.57",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@embedpdf/core": "^2.14.4",
    "@embedpdf/engines": "^2.14.4",
    "@embedpdf/pdfium": "^2.14.4",
    "@embedpdf/plugin-document-manager": "^2.14.4",
    "@embedpdf/plugin-render": "^2.14.4",
    "@embedpdf/plugin-scroll": "^2.14.4",
    "@embedpdf/plugin-viewport": "^2.14.4",
    "@embedpdf/plugin-zoom": "^2.14.4",
    "@tanstack/db": "^0.6.16",
    "@tanstack/react-db": "^0.1.94",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-virtual": "^3.14.6",
    "convex": "^1.42.1",
    "driver.js": "^1.8.0",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.11.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "valibot": "^1.4.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4",
    "@types/highlight.js": "^9.12.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-storybook": "^10.5.7",
    "playwright": "^1.55.0",
    "storybook": "^10.5.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3"
  }
}
