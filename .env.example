# Appwrite (https://cloud.appwrite.io/console)
# Add a Web platform with hostname `localhost`.
# API key scopes: users.read, users.write, sessions.write,
# messaging.read, messaging.write (for emailing pages)
# Auth verification + Messaging emails need a provider in Console:
# Messaging → Providers → Email (Mailgun / Resend / Sendgrid / SMTP)

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=<PROJECT_ID>
APPWRITE_API_KEY=<API_KEY>

# TablesDB id for workspaces / folders / pages (created by scripts/provision-shelf-db.mjs)
NEXT_PUBLIC_APPWRITE_DATABASE_ID=notevalut

# Storage bucket for vault uploads (created by scripts/provision-storage.mjs)
# API key also needs storage.read + storage.write
NEXT_PUBLIC_APPWRITE_BUCKET_ID=vault-files

# Used as fallback for verification / password-reset email links (browser uses window.origin).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional HMAC secret for 30-minute password-reset links (defaults to a key derived from APPWRITE_API_KEY).
# AUTH_RECOVERY_SECRET=<long-random-string>

# Password reset emails go through Appwrite Messaging (same Email provider as page share).
# API key needs: users.read, users.write, messaging.read, messaging.write

# Rate limits for /api/appwrite (per IP, per window, in-memory per Node process)
# RATE_LIMIT_API_GET_MAX=120
# RATE_LIMIT_API_POST_MAX=40
# RATE_LIMIT_AUTH_MAX=15
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_AUTH_WINDOW_MS=60000
